{
  "schema": "webox-ui-layout/1",
  "id": "webex-default",
  "name": "Webex",
  "surfaces": { "main": {
    "dock": "top", "id": "header", "size": { "pref": "{metrics.header_h}" },
    "child": { "slot": "header" },
    "rest": {
      "dock": "left", "id": "rail", "size": { "pref": "{rail.width}" },
      "child": { "slot": "rail", "variants": { "orientation": "vertical", "labels": "when_wide" } },
      "rest": { "switch": "nav.page", "cases": {
        "messaging": { "split": "row", "id": "msg-split", "gap": 4, "items": [
          { "size": { "min": 280, "pref": "{list.width}", "max": 400, "resizable": true },
            "when": { "not": { "key": "ui.list_hidden" } },
            "node": { "card": "list", "child": { "slot": "space_list" } } },
          { "size": { "min": 560 }, "node": { "card": "content", "child": { "slot": "conversation" } } } ] },
        "settings": { "split": "row", "id": "settings-split", "gap": 4, "items": [
          { "size": { "pref": "{settings.nav_width}" }, "node": { "card": "list", "child": { "slot": "settings_nav" } } },
          { "node": { "card": "content", "child": { "slot": "settings_page" } } } ] },
        "*": { "slot": "page" } } } } } }
}
